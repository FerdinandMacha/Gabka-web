---
import { Image } from "astro:assets";
import eucalyptus from "../assets/eucalyptus.png";
import { plasma } from "../data/content";
---
<section class="section" id="plasma" aria-labelledby="plasma-title">
  <Image class="branch" src={eucalyptus} width={720} alt="" loading="lazy" aria-hidden="true" />

  <div class="container">
    <h2 id="plasma-title">Frekvenční péče plasmového generátoru</h2>

    <div class="cols">
      <div class="text">
        {plasma.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <div class="programs">
        <h3>{plasma.programsIntro}</h3>
        <ul class="checklist">
          {plasma.programs.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>

    <p class="disclaimer">{plasma.disclaimer}</p>
  </div>
</section>

<style>
  .section { background: var(--cream-light); overflow: hidden; }
  .container { position: relative; z-index: 1; }
  .branch {
    position: absolute; top: 0.5rem; right: -2.5rem; width: clamp(15rem, 32vw, 28rem);
    transform: rotate(155deg); opacity: 0.9; pointer-events: none; z-index: 0;
  }
  h2 { max-width: 20ch; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .cols { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .text { display: grid; gap: 1.25rem; }
  .programs { background: rgb(255 255 255 / 0.7); border: 1px solid rgb(42 123 118 / 0.2); border-radius: 1.25rem; padding: clamp(1.5rem, 3vw, 2.25rem); display: grid; gap: 1.25rem; }
  .programs h3 { font-size: var(--step-0); font-weight: 650; color: var(--charcoal); }
  .disclaimer {
    margin-top: clamp(2rem, 5vw, 3.5rem); max-width: 80ch; font-size: var(--step--1); line-height: 1.6;
    padding-left: 1.1rem; border-left: 3px solid var(--teal-soft);
  }
  @media (max-width: 52rem) {
    .cols { grid-template-columns: 1fr; }
    .branch { top: -0.5rem; right: -6rem; opacity: 0.5; }
  }
</style>
