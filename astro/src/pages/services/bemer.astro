---
import Base from "../../layouts/Base.astro";
import Bemer from "../../components/Bemer.astro";
---
<Base
  title="BEMER | Ostrava Třebovice – Na Vlně regenerace"
  description="Představení fyzikální cévní terapie BEMER a možností propojení s masáží v Ostravě Třebovicích."
>
  <section class="page-intro">
    <div class="container">
      <h1>BEMER v Ostravě Třebovicích</h1>
      <p class="lead lead--italic">Fyzikální cévní terapie jako součást individuální regenerační péče.</p>
    </div>
  </section>
  <Bemer />
</Base>

<style>
  .page-intro { padding-block: clamp(3rem, 7vw, 5rem) 0; }
  h1 { max-width: 22ch; font-size: var(--step-3); }
  .lead { margin-top: 1rem; }
</style>
